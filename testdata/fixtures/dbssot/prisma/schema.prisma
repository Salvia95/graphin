// graphin dbssot fixture: prisma SSOT

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        BigInt   @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  posts     Post[]

  @@map("users")
}

model Post {
  id       BigInt @id @default(autoincrement())
  title    String
  author   User   @relation(fields: [authorId], references: [id])
  authorId BigInt @map("author_id")

  @@map("posts")
  @@schema("blog")
}

model Tag {
  id   BigInt @id @default(autoincrement())
  name String @unique
}

enum Role {
  USER
  ADMIN
}
