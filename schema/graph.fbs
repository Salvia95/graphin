// Forward-graph shard schema (§6.2). Shards are mmapped and read zero-copy;
// regenerate Go code with `make fbs` (flatc 25.12.19, see scripts/fetch-flatc.sh).
namespace fbsgen;

// ForeignKey는 graphindb RDB 노드 전용(테이블→참조 테이블).
// Contains는 마크다운 전용(파일→섹션, 섹션→하위 섹션, docs/markdown-spec.md
// §3.5): 대상이 파싱 시점에 이미 확정된 구조적 사실이라 신뢰도는 항상 1.0이다.
// 기존 샤드와의 하위호환을 위해 끝에만 추가한다.
enum EdgeType : byte { Import, Extends, Implements, Call, Reference, ForeignKey, Contains }

table Edge {
  target_id: string (required);
  type: EdgeType;
  confidence: float;      // 0.0 ~ 1.0
}

table Node {
  id: string (required);  // §2.3 ID 규약
  display_name: string;
  kind: string;           // class | interface | method | function
  file_path: string (required);
  start_byte: uint32;
  end_byte: uint32;
  subtree_hash: [ubyte];  // BLAKE3-256 (32 bytes)
  partial: bool;          // 파싱 에러 부분 트리 여부
  uses: [Edge];
  // rename_key는 이름이 바뀌어도 살아남는 내용의 해시다: 마크다운 섹션은
  // 헤딩 줄을 뺀 본문의 BLAKE3-256이고, 나머지 노드 종류는 비어 있다.
  //
  // subtree_hash로는 리네임을 못 잡는다 — 섹션 스팬이 헤딩 줄에서 시작하므로
  // 제목만 고쳐도 해시가 바뀐다. 그래서 "내용은 같은데 ID만 달라진" 노드를
  // 찾으려면 제목을 뺀 키가 따로 있어야 한다.
  //
  // 재시작 후에도 탐지가 되려면 디스크에 남아야 한다: 샤드에서 복원한 옛
  // 레코드가 이 값을 잃으면, 서버를 켠 뒤 처음 일어나는 리네임이 전부
  // 그냥 삭제로 보인다.
  rename_key: [ubyte];
}

table Shard {
  package_prefix: string (required);
  generation: uint64;     // 원자적 교체 세대 번호
  nodes: [Node];
}

root_type Shard;
