# build artifacts
/bin/
/dist/

# graphin runtime data (never commit index/model data). `ignore` is config, not
# runtime data, so it is the one file that ships — a fresh clone gets the same
# exclusions. Re-including needs `.graphin/*`, not `.graphin/`: git cannot
# re-include anything under an excluded *directory*.
.graphin/*
!.graphin/ignore

# provisioned models & onnxruntime shared libraries
*.onnx
*.ort
libonnxruntime*

# editor/OS noise
.idea/
.vscode/
*.swp
.DS_Store

# console interface: sources are committed, the build output is not. The
# .gitkeep is, because //go:embed fails on a pattern that matches nothing and
# `go build` has to keep working without a node toolchain.
internal/console/ui/node_modules/
internal/console/ui/tsconfig.tsbuildinfo
internal/console/ui/dist/*
!internal/console/ui/dist/.gitkeep
.rag-bench-unlock
